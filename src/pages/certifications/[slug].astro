---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

/** 1️⃣ Generar todas las rutas estáticas */
export async function getStaticPaths() {
  const certifications = await getCollection("certifications");

  return certifications.map((certification) => ({
    params: { slug: certification.slug },
    props: { certification },
  }));
}

/** 2️⃣ Recibir el proyecto correspondiente */
const { certification } = Astro.props;

/** 3️⃣ Renderizar el Markdown */
const { Content } = await certification.render();
---

<SiteLayout {...certification.data}>
  <Content />
</SiteLayout>
